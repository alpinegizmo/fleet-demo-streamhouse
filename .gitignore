# OS
.DS_Store

# Node
node_modules/
npm-debug.log*

# Local secrets and overrides - never commit; fleet-context-engine/.env.example
# is the tracked template
.env
.env.*
!.env.example

# Claude Code local/machine-specific settings
.claude/settings.local.json

# Leftovers from the Confluent Cloud version of this demo (terraform/ state
# and tfvars may still exist in local checkouts - keep them out of git)
**/*.tfstate
**/*.tfstate.*
**/.terraform/
**/.terraform.lock.hcl
**/terraform.tfvars
**/*.auto.tfvars
.rtce-credentials
fleet-context-engine/.rtce-credentials
