{
  "type": "record",
  "name": "DeliveryRecommendation",
  "namespace": "fleet",
  "doc": "Generated by Flink with a local LLM: one recommended delivery-ops action per delivery performance event.",
  "fields": [
    {"name": "vehicle_id", "type": "string"},
    {"name": "geozone", "type": ["null", "string"], "default": null},
    {"name": "performance_status", "type": ["null", "string"], "default": null},
    {"name": "parcels_onboard", "type": ["null", "int"], "default": null},
    {"name": "recommendation", "type": ["null", "string"], "default": null}
  ]
}
