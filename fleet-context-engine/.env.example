# Only needed when running fleet-context-engine directly on the host
# (`npm start`) instead of via `docker compose up`, which sets these itself.
# Copy to .env and fill in (cp .env.example .env). .env is gitignored.

# --- Kafka and Schema Registry: required for LOCAL mode. Leave
# KAFKA_BOOTSTRAP unset to run in SIMULATED mode instead (no Kafka needed).
# From the host, the compose broker is on 9094 and the registry on 8085. ---
KAFKA_BOOTSTRAP=localhost:9094
SCHEMA_REGISTRY_URL=http://localhost:8085

# --- LLM for the /api/ask chat agent: any OpenAI-compatible API. ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b    # shown in the console; the chat agent falls back to it
CHAT_MODEL=qwen2.5:3b   # the chat agent's model

# --- The simulator's starting pace: normal | slow | minimal (the console's
# Background traffic switch changes it at runtime). ---
# SIM_PACE=normal

# --- Stop the continuous telemetry simulator. ---
# AUTO_TELEMETRY=false

# --- Local server port (default 8787). ---
# HTTP_PORT=8787
